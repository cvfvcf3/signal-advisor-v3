# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/signal_advisor

# Required for public production deployments
TICK_SECRET=
ADMIN_SECRET=

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_CONFIDENCE=70

# Optional self-hosted background loop
ENABLE_BACKGROUND_TICK=0
TICK_INTERVAL_MS=30000
